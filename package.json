{
  "name": "@opencoachingformat/spec",
  "version": "1.4.0",
  "type": "module",
  "description": "Open standard for team-sport coaching diagrams and animations (invasion team sports; basketball first).",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opencoachingformat/spec.git"
  },
  "homepage": "https://opencoachingformat.org",
  "bugs": {
    "url": "https://github.com/opencoachingformat/spec/issues"
  },
  "license": "CC-BY-4.0",
  "files": [
    "schema",
    "positions",
    "sports",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./schema/v1.json": "./schema/v1.json",
    "./positions/resolve-position.mjs": "./positions/resolve-position.mjs",
    "./positions/fiba-v1.json": "./positions/fiba-v1.json",
    "./positions/nba-v1.json": "./positions/nba-v1.json",
    "./positions/ncaa-v1.json": "./positions/ncaa-v1.json",
    "./positions/nfhs-v1.json": "./positions/nfhs-v1.json",
    "./sports/basketball-v1.json": "./sports/basketball-v1.json",
    "./sports/soccer-v0.0.1.json": "./sports/soccer-v0.0.1.json",
    "./sports/handball-v0.0.1.json": "./sports/handball-v0.0.1.json",
    "./sports/hockey-v0.0.1.json": "./sports/hockey-v0.0.1.json",
    "./sports/futsal-v0.0.1.json": "./sports/futsal-v0.0.1.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "validate": "ajv validate --spec=draft7 --strict-schema=false -s schema/v1.json -d \"examples/*.ocf.json\" --all-errors --verbose -c ajv-formats",
    "test:invalid": "node scripts/check-invalid.mjs",
    "test:positions": "node --test test/positions-anchors.test.mjs",
    "test:sport": "node --test test/sport-branches.test.mjs",
    "test:version": "node --test test/schema-version.test.mjs",
    "test:manifest": "node --test test/versions-manifest.test.mjs",
    "test": "npm run validate && npm run test:invalid && npm run test:positions && npm run test:sport && npm run test:version && npm run test:manifest"
  },
  "devDependencies": {
    "ajv-cli": "^5.0.0",
    "ajv-formats": "^3.0.1"
  }
}
