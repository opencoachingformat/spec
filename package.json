{
  "name": "@opencoachingformat/spec",
  "version": "2.0.0-alpha.1",
  "type": "module",
  "description": "Open standard for team-sport coaching diagrams and animations (invasion team sports; basketball first).",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opencoachingformat/spec.git"
  },
  "homepage": "https://opencoachingformat.org",
  "bugs": {
    "url": "https://github.com/opencoachingformat/spec/issues"
  },
  "license": "CC-BY-4.0",
  "files": [
    "schema",
    "positions",
    "sports",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./schema/v1.json": "./schema/v1.json",
    "./positions/resolve-position.mjs": "./positions/resolve-position.mjs",
    "./sports/basketball/sport.json": "./sports/basketball/sport.json",
    "./sports/basketball/court_profiles/fiba.json": "./sports/basketball/court_profiles/fiba.json",
    "./sports/basketball/court_profiles/nba.json": "./sports/basketball/court_profiles/nba.json",
    "./sports/basketball/court_profiles/ncaa.json": "./sports/basketball/court_profiles/ncaa.json",
    "./sports/basketball/court_profiles/nfhs.json": "./sports/basketball/court_profiles/nfhs.json",
    "./sports/soccer/sport.json": "./sports/soccer/sport.json",
    "./sports/handball/sport.json": "./sports/handball/sport.json",
    "./sports/hockey/sport.json": "./sports/hockey/sport.json",
    "./sports/futsal/sport.json": "./sports/futsal/sport.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "validate": "ajv validate --spec=draft7 --strict-schema=false -s schema/v1.json -d \"examples/*.ocf.json\" --all-errors --verbose -c ajv-formats",
    "test:invalid": "node scripts/check-invalid.mjs",
    "test:positions": "node --test test/positions-anchors.test.mjs",
    "test:sport": "node --test test/sport-branches.test.mjs test/sport-court-profile-whitelist.test.mjs",
    "test:version": "node --test test/schema-version.test.mjs",
    "test:manifest": "node --test test/versions-manifest.test.mjs",
    "test:frameless": "node --test test/frameless-*.test.mjs",
    "test:registry": "node --test test/court-contract.test.mjs test/not-applicable-positions.test.mjs",
    "test": "npm run validate && npm run test:invalid && npm run test:positions && npm run test:sport && npm run test:version && npm run test:manifest && npm run test:frameless && npm run test:registry"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-cli": "^5.0.0",
    "ajv-formats": "^3.0.1"
  }
}
