---
import { readFileSync } from 'node:fs';
import path from 'node:path';
import Base from '../../../layouts/Base.astro';

export function getStaticPaths() {
  // Resolve the generated dir from the site root (where `npm run build` runs).
  // Astro compiles pages to a different location at build time, so anchoring
  // off import.meta.url is unreliable here; cwd is the site package root.
  const arc42Dir = path.resolve(process.cwd(), 'src/generated/arc42');
  const index = JSON.parse(
    readFileSync(path.join(arc42Dir, 'index.json'), 'utf-8')
  );
  return index.map((entry, i) => {
    const html = readFileSync(path.join(arc42Dir, `${entry.slug}.html`), 'utf-8');
    const prev = i > 0 ? index[i - 1] : null;
    const next = i < index.length - 1 ? index[i + 1] : null;
    return {
      params: { section: entry.slug },
      props: { entry, html, prev, next, hasMermaid: html.includes('<pre class="mermaid">') },
    };
  });
}

const { entry, html, prev, next, hasMermaid } = Astro.props;
---
<Base
  title={`${entry.title} — Architecture`}
  description={`arc42 architecture documentation for the OCF validator: ${entry.title}.`}
  wide
>
  {hasMermaid && (
    <script type="module" is:inline slot="head">
      {`import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs';
mermaid.initialize({ startOnLoad: false, theme: 'dark' });
mermaid.run();`}
    </script>
  )}

  <nav class="crumbs" aria-label="Breadcrumb">
    <a href="/build/">Build</a>
    <span aria-hidden="true">/</span>
    <a href="/build/architecture/">Architecture</a>
  </nav>

  <article class="arc42-content" set:html={html}></article>

  <nav class="section-nav" aria-label="Section navigation">
    {prev ? (
      <a class="prev" href={`/build/architecture/${prev.slug}/`}>← {prev.title}</a>
    ) : (
      <span></span>
    )}
    {next ? (
      <a class="next" href={`/build/architecture/${next.slug}/`}>{next.title} →</a>
    ) : (
      <span></span>
    )}
  </nav>

  <p class="back"><a href="/build/architecture/">← All sections</a></p>
</Base>

<style>
  .crumbs {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    font-size: 0.9rem;
    color: var(--text-muted);
    margin-bottom: 1rem;
  }
  .arc42-content {
    max-width: 72ch;
  }
  /* Mermaid renders SVG into the .mermaid pre client-side; make it large and
     responsive, and give it room even before the client script runs. */
  .arc42-content :global(pre.mermaid) {
    margin: 1.5rem 0;
    text-align: center;
    background: transparent;
    overflow-x: auto;
  }
  .arc42-content :global(pre.mermaid svg) {
    max-width: 100%;
    height: auto;
  }
  .arc42-content :global(pre) {
    overflow-x: auto;
  }
  .arc42-content :global(img) {
    max-width: 100%;
    height: auto;
  }
  .arc42-content :global(table) {
    border-collapse: collapse;
  }
  .arc42-content :global(th),
  .arc42-content :global(td) {
    border: 1px solid var(--border);
    padding: 0.4rem 0.6rem;
  }
  .section-nav {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 2.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }
  .section-nav a {
    font-weight: 600;
  }
  .back {
    margin-top: 1.5rem;
  }
</style>
