---
import Base from '../../layouts/Base.astro';
import schema from '../../generated/schema.json';

const pretty = JSON.stringify(schema, null, 2);
---
<Base
  title="JSON Schema"
  description="Canonical JSON Schema (Draft-07) for the Open Coaching Format v2 — court, entities, actions, and branches."
>
  <h1>JSON Schema (v2)</h1>
  <p>
    Canonical schema: <code>{schema.$id}</code>
  </p>
  <pre tabindex="0"><code>{pretty}</code></pre>
</Base>
